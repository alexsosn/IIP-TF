{
  "schema_version": 1,
  "plugin": {
    "id": "iip-tf",
    "name": "IIP-TF",
    "version": "0.1.0.dev0",
    "repository": "alexsosn/IIP-TF"
  },
  "materializers": [
    {
      "id": "iip-epidoc-text-fabric",
      "description": "Convert the complete pinned Brown Inscriptions of Israel/Palestine EpiDoc source with person and taxonomy authorities into local native Text-Fabric, including its source-critical browser.",
      "acquisition": [
        {
          "type": "git",
          "url": "https://github.com/Brown-University-Library/iip-texts.git",
          "ref": "0b7dc8358ccdfd0c9391f049da4839fbd91c26e5",
          "subpath": "."
        },
        {
          "type": "user-local",
          "path_type": "directory",
          "prompt": "Select the root directory of an IIP iip-texts checkout containing epidoc-files/, include_taxonomies.xml and data-keep/persons.xml"
        }
      ],
      "input": {
        "type": "directory",
        "required_globs": [
          "epidoc-files/*.xml",
          "include_taxonomies.xml",
          "data-keep/persons.xml"
        ],
        "allow_symlinks": false
      },
      "execution": {
        "type": "python-module",
        "module": "iip_tf.agora",
        "args": [
          "{source}",
          "{output}",
          "--source-revision",
          "{source_revision}"
        ],
        "network": "deny"
      },
      "output": {
        "format": "text-fabric",
        "required_paths": [
          "tf/otype.tf",
          "tf/oslots.tf",
          "tf/otext.tf",
          "app/app.py",
          "app/config.yaml",
          "app/static/display.css",
          "conversion-summary.json"
        ]
      }
    }
  ]
}
